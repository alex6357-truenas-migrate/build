# src.conf.build — 15.1 目标：world + kernel（整机 = 15.1 主机）
# 数据基础：15.1 share/mk/src.opts.mk（158 项合法 WITHOUT_*）
#
# ===== 有效保留（15.1 仍然提供） =====
WITHOUT_TESTS=yes
WITHOUT_WIRELESS=yes
WITHOUT_BLUETOOTH=yes
WITHOUT_BSDINSTALL=yes
WITHOUT_BSNMP=yes
WITHOUT_CALENDAR=yes
WITHOUT_DICT=yes
WITHOUT_GAMES=yes
WITHOUT_HTML=yes
WITHOUT_IPFILTER=yes
WITHOUT_LPR=yes
WITHOUT_SENDMAIL=yes
WITHOUT_SYSCONS=yes
WITHOUT_ZFS=no             # base OpenZFS 2.4.2 仍编（13.3 起我们用 rools openzfs port）

# ===== 显式强化（非 WITHOUT_*） =====
CFLAGS+=-DNS_REREAD_CONF
LOCAL_DIRS="share/examples/ses tools/tools/cxgbtool tools/tools/cxgbetool"

# ===== 已删（15.1 已不张扬） =====
# WITHOUT_ATM / CTOOM / FORTRAN / GCOV / GPIB / IPX / LIB32 / LIBKSE / NDIS / NLS / OBJC
# WITHOUT_PC_SYSINSTALL / PPPL / RCMDS / SVNLITE / SYSINSTALL
# WITHOUT_CLANG_FULL / PROFILE
# WITHOUT_FREEBSD_UPDATE / TOOLCHAIN / INSTALLLIB / MAN / NIS / DEBUG_FILES / KERNEL_SYMBOLS
# WITH_OPENSSH_NONE_CIPHER（已删：OPENSSH_NONE_CIPHER 自 15.x 再也不提供 "none cipher"）
