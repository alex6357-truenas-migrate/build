# poudriere.conf.tmpl — build 的 poudriere 配置模板
# 占位符 @@BASEFS@@ 由 mk/ports.mk 的 poudriere-setup 替换。

NO_ZFS=yes
BASEFS=@@BASEFS@@
USE_PORTLINT=no
USE_TMPFS=yes
DISTFILES_CACHE=@@BASEFS@@/distfiles
PKG_REPO_FROM_HOST=yes
CCACHE_DIR=
ALLOW_NETWORK_ACCESS=		# 默认空：poudriere 环境断网；依赖 distcache 或 PRE_FETCH 钩子
CHECK_CHANGED_OPTIONS=yes
CHECK_CHANGED_DEPS=yes
ATOMIC_PACKAGE_REPOSITORY=yes
COMMIT_PACKAGES_ON_FAILURE=no
KEEP_OLD_PACKAGES=yes
KEEP_OLD_PACKAGES_COUNT=2

# 私货源码 mount：freenas/py-middlewared 等 port 的 WRKSRC 指向 /usr/nas_source/*
# （13.3 同款机制；host 侧由 ports.mk nas-source-bind 目标 mount_nullfs 绑定）。
# /usr/src 一道挂：kmod 类 ports（如 filesystems/openzfs-kmod）需在 jail 里
# 看见内核源码。注意我们 VM 上 /usr/src 就是打过补丁的 work/src 本体。
NULLFS_PATHS="/rescue /usr/share /usr/tests /usr/lib32 /usr/nas_source /usr/src"
