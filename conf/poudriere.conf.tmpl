# poudriere.conf.tmpl — build 的 poudriere 配置模板
# 占位符 @@BASEFS@@ （以及历史遗稿 @@NAS_NULLFS@@，恒展开为空）由 mk/ports.mk 的 poudriere-setup 替换。

NO_ZFS=yes
ZPOOL=zroot
BASEFS=@@BASEFS@@
USE_PORTLINT=no
USE_TMPFS=no
DISTFILES_CACHE=@@BASEFS@@/distfiles
PKG_REPO_FROM_HOST=yes
CCACHE_DIR=
ALLOW_NETWORK_ACCESS=all	# 首跑放行网络（dist 预不全会 fail:fetch）；稳定后可收紧
CHECK_CHANGED_OPTIONS=yes
CHECK_CHANGED_DEPS=yes
ATOMIC_PACKAGE_REPOSITORY=yes
COMMIT_PACKAGES_ON_FAILURE=yes
KEEP_OLD_PACKAGES=yes
KEEP_OLD_PACKAGES_COUNT=2

# 私货源与内核源码统一拷进 jail 镜像（mk/ports.mk skeleton-jail）：
# NULLFS 在 15.1 有双重坑——/usr/src 直挂 EDEADLK；nas_source 经 ref jail
# 持久挂载后 host 侧 rebinding 不生效（13 轮实测 jail 内空目录）。
NULLFS_PATHS="/rescue /usr/share /usr/tests /usr/lib32 @@NAS_NULLFS@@"
