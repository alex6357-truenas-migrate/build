From 04b86138899146a5b6e30391e3a06124be99f7c1 Mon Sep 17 00:00:00 2001
From: Alex6357 <73743056+Alex6357@users.noreply.github.com>
Date: Mon, 10 Aug 2026 20:51:20 +0800
Subject: [PATCH] recommended: amd64 improve backward overlapping memmove
 performance (e7f5d361ddb)

support.S memmove() backward overlapping branch (src>dst): raise ERMS
threshold from cmpq $256 to cmpq $680 and label 2256->2680. Below 680
bytes use REP MOVSQ + register loop; above use std+REP MOVSB (ERMS).
ERMS does not optimize backward copy; on Cascade Lake Xeon the MOVSQ
path is ~70% faster. Pure performance tuning, no interface/behavior
change. Conflict-free rebase (15.1 support.S drifted +35 lines but
this site merged automatically).

NOTE: RFB wait interval tuning (cc792d3faec) is folded into the
bhyve-vnc integration patch (rfb.h RFB_WAIT_INTERVAL=1), not separate.
---
 sys/amd64/amd64/support.S | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/sys/amd64/amd64/support.S b/sys/amd64/amd64/support.S
index 27694a95653c..e3883804c4f6 100644
--- a/sys/amd64/amd64/support.S
+++ b/sys/amd64/amd64/support.S
@@ -427,8 +427,8 @@ END(memcmp)
 	 */
         ALIGN_TEXT
 2:
-	cmpq	$256,%rcx
-	ja	2256f
+	cmpq	$680,%rcx
+	ja	2680f
 
 	leaq	-8(%rdi,%rcx),%rdi
 	leaq	-8(%rsi,%rcx),%rsi
@@ -503,7 +503,7 @@ END(memcmp)
 	\end
 	ret
 	ALIGN_TEXT
-2256:
+2680:
 	std
 	leaq	-8(%rdi,%rcx),%rdi
 	leaq	-8(%rsi,%rcx),%rsi
