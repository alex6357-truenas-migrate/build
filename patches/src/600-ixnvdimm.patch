+	char *e;
+	int F = 0, I = 0, b, c, d = 0, i, fd, h = 0, r = 0, w = 0;
+	int page = -1, off = -1, size = 1;
+	uint32_t funcs, val;
+	uint8_t	buf[4];
+
+	progname = argv[0];
+
+	while ((c = getopt(argc, argv, "FIdf:hrw")) != -1) {
+		switch (c) {
+		case 'd':
+			d = 1;
+			break;
+		case 'F':
+			F = 1;
+			break;
+		case 'I':
+			I = 1;
+			break;
+		case 'f':
+			f = optarg;
+			break;
+		case 'r':
+			r = 1;
+			break;
+		case 'w':
+			w = 1;
+			break;
+		case 'h':
+			h = 1;
+			size = 2;
+			break;
