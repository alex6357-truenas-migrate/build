+static struct resource_list *
+nvdimm_root_get_resource_list(device_t dev, device_t child)
+{
+	struct nvdimm_child *ivar;
+
+	ivar = (struct nvdimm_child *)device_get_ivars(child);
+	return &ivar->resources;
+}
