+			if (page >= 0 && regs[i].page != page)
+				continue;
+			printf("%-36s ", regs[i].name);
+			for (b = 0; b < regs[i].size; b++)
+				printf("%02x", i2c_read(fd, regs[i].page, regs[i].off + regs[i].size - b - 1));
+			printf("\n");
