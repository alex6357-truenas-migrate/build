+static device_method_t nvdimm_methods[] = {
+	/* Device interface */
+	DEVMETHOD(device_probe,		nvdimm_probe),
+	DEVMETHOD(device_attach,	nvdimm_attach),
+	DEVMETHOD(device_detach,	nvdimm_detach),
+	{ 0, 0 }
+};
