+static int
+pmem_open(struct disk *dp)
+{
+	struct pmem_disk *sc = dp->d_drv1;
+
+	if (!cold && sc->dma.numch == 0)
+		pmem_dma_init(sc->dev);
+	sc->label->opened = 1;
+	return (0);
+}
+
+static int
+pmem_close(struct disk *dp)
+{
+	struct pmem_disk *sc = dp->d_drv1;
+
+	sc->label->opened = 0;
+	return (0);
+}
