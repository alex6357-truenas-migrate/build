diff --git a/libexec/rc/rc.dynamicdiskless b/libexec/rc/rc.dynamicdiskless
new file mode 100644
index 000000000000..c2de85a5f43d
--- /dev/null
+++ b/libexec/rc/rc.dynamicdiskless
@@ -0,0 +1,126 @@
+#!/bin/sh
+#
