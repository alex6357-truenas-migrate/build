 libexec/rc/rc                 |   5 ++
 libexec/rc/rc.d/devd          |   1 -
 libexec/rc/rc.d/mountd        |   3 +-
 libexec/rc/rc.d/nfsd          |   9 +--
 libexec/rc/rc.dynamicdiskless | 126 ++++++++++++++++++++++++++++++++++
 libexec/rc/rc.initdiskless    |   3 +-
 7 files changed, 141 insertions(+), 8 deletions(-)
 create mode 100644 libexec/rc/rc.dynamicdiskless

